# ============================================================
# Application
# ============================================================
APP_NAME=Dashboard
APP_ENV=development
SECRET_KEY=change_this_to_a_long_random_secret_key

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=5000
# waitress thread pool size (production only) — waitress's own default is
# 4, bumped to 8 here since several NOC staff can have the dashboard open
# at once, each page load makes ~10 sequential cache reads, and every open
# tab auto-reloads on the same aligned timer (synchronized bursts).
WAITRESS_THREADS=8

# ============================================================
# PostgreSQL Database
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_db
DB_USER=postgres
DB_PASSWORD=your_password
SITE_SYNC_INTERVAL_SECONDS=300
INCIDENT_SYNC_INTERVAL_SECONDS=300
APE_ALARM_SYNC_INTERVAL_SECONDS=300
VIP_ALARM_SYNC_INTERVAL_SECONDS=300
VIP_SITE_SYNC_INTERVAL_SECONDS=300
SITE_LOOKUP_SYNC_INTERVAL_SECONDS=300
POP_SYNC_INTERVAL_SECONDS=300
MSSQL_SITE_ONAIR_SYNC_INTERVAL_SECONDS=300
PARTNER_CONTACT_SYNC_INTERVAL_SECONDS=300
PARTNER_CONTACT_IMPORT_PASSWORD=nocdashboard
DASHBOARD_LOG_INTERVAL_SECONDS=300
ALL_TASKS_SUMMARY_INTERVAL_SECONDS=300

# ============================================================
# Database Connection Pool
# ============================================================
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=20

# ============================================================
# MSSQL (alarm source for ISP POP / EZE / TCT cards)
# ============================================================
MSSQL_HOST=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_SYNC_INTERVAL_SECONDS=10

# ============================================================
# Dashboard
# ============================================================
TIMEZONE=Asia/Phnom_Penh
DEFAULT_THEME=light
ROWS_PER_PAGE=25
CARD_LAYOUT_RESET_VERSION=1

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_PATH=logs/app.log
LOG_ERROR_PATH=logs/error.log
DASHBOARD_LOG_PATH=logs/dashboard.log
TELEGRAM_LOG_PATH=logs/telegram.log
WEBHOOK_LOG_PATH=logs/webhook.log
ATTEMPTS_LOG_PATH=logs/attempts.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================
# Session
# ============================================================
SESSION_TIMEOUT=3600
# Only matters when APP_ENV=production. Leave at True once served over
# HTTPS. Set to False only if still on plain HTTP (e.g. http://<ip>:5000)
# - otherwise every form submit fails with "The CSRF session token is
# missing", since the browser won't send a Secure-flagged cookie over HTTP.
SESSION_COOKIE_SECURE=True

# ============================================================
# Notification (Optional)
# ============================================================
# Legacy single-channel webhook — superseded by the 10 per-card
# TEAMS_WEBHOOK_* URLs below (webhook/ package), kept for compatibility.
TEAMS_WEBHOOK=
# Master switch + interval for the Teams webhook loop (webhook/__init__.py).
# WEBHOOK_SEND_EMPTY=true also posts a "no active alarms" card when a
# card has no active data, instead of staying silent.
TEAMS_ALERTS_ENABLED=true
TEAMS_ALERT_INTERVAL_SECONDS=900
WEBHOOK_SEND_EMPTY=false
# Base dashboard URL used to build "View in Dashboard" links in Teams cards.
DASHBOARD_URL=
# One Teams incoming-webhook URL per card (webhook/<name>.py) — an unset
# URL just means that card's webhook is skipped, not an error.
TEAMS_WEBHOOK_EZE_ALERTS=
TEAMS_WEBHOOK_TCT_DOWN=
TEAMS_WEBHOOK_POP_DOWN=
TEAMS_WEBHOOK_POP_MAIN_FAILURE=
TEAMS_WEBHOOK_MAIN_FAILURE=
TEAMS_WEBHOOK_CURRENT_SITES_DOWN_ALARMS=
TEAMS_WEBHOOK_CSO_SUB_CON=
TEAMS_WEBHOOK_CURRENT_SITES_OUTAGE=
TEAMS_WEBHOOK_DG_ON=
TEAMS_WEBHOOK_INC_WO_SITE_DOWN=
# Site Down Telegram alert (app/services/telegram/telegram_alert.py)
TELEGRAM_BOT_TOKEN=
# Comma-separated — one alert can go to more than one chat/group.
TELEGRAM_CHAT_IDS=
ALERT_THRESHOLD_MIN=240
ALERT_INTERVAL_SECONDS=14400
# INC-WO Site Down Telegram alert (app/services/telegram/telegram_inc_wo_alert.py)
# — a separate bot from TELEGRAM_BOT_TOKEN above, posting to its OWN
# TELEGRAM_CHAT_IDS_INC_WO group. Never starts unless both are set — and
# the bot must already be a member of that group, or Telegram returns
# "chat not found" even with a correct token/chat id. Threshold 0 = every
# current INC-WO Site Down row is sent every INC_WO_ALERT_INTERVAL_SECONDS
# (default 900s/15min), not just ones open past a threshold.
TELEGRAM_BOT_INC_WO_TOKEN=
TELEGRAM_CHAT_IDS_INC_WO=
INC_WO_ALERT_THRESHOLD_MIN=0
INC_WO_ALERT_INTERVAL_SECONDS=900
# INC-WO Category Power Telegram alert
# (app/services/telegram/telegram_inc_wo_power_alert.py) — a THIRD,
# separate bot from both TELEGRAM_BOT_TOKEN and TELEGRAM_BOT_INC_WO_TOKEN
# above, posting to its OWN TELEGRAM_CHAT_IDS_INC_WO_POWER group. Never
# starts unless both are set. Telegram-only — no dashboard card behind
# this one. Same threshold-0/900s defaults as the INC-WO Site Down alert.
TELEGRAM_BOT_INC_WO_POWER_TOKEN=
TELEGRAM_CHAT_IDS_INC_WO_POWER=
INC_WO_POWER_ALERT_THRESHOLD_MIN=0
INC_WO_POWER_ALERT_INTERVAL_SECONDS=900
# INC-WO General Telegram alert
# (app/services/telegram/telegram_inc_wo_general_alert.py) — a FOURTH,
# separate bot, posting to its OWN TELEGRAM_CHAT_IDS_INC_WO_GENERAL group.
# Every INC-WO category EXCEPT site_down/power (those two already have
# their own dedicated alerts above). Never starts unless both are set.
# Telegram-only — no dashboard card behind this one. Same threshold-0/900s
# defaults as the other two INC-WO alerts.
TELEGRAM_BOT_INC_WO_GENERAL_TOKEN=
TELEGRAM_CHAT_IDS_INC_WO_GENERAL=
INC_WO_GENERAL_ALERT_THRESHOLD_MIN=0
INC_WO_GENERAL_ALERT_INTERVAL_SECONDS=900

# ============================================================
# Security
# ============================================================
CSRF_ENABLED=True

# ============================================================
# Enable and disable features (dashboard card visibility)
# ============================================================
FEATURE_VVIP_SITE=True
FEATURE_MENTOR_SITE=True
FEATURE_ISP_POP=True
FEATURE_TCT_PORT=True
FEATURE_INCIDENT_INCWO_STATUS=True
FEATURE_RAN_STATUS=True
FEATURE_INCIDENT_SITEDOWN=True
FEATURE_ALARM_SITE_DOWN=True
FEATURE_ALARM_COMPLETELY_SITE_DOWN=True
FEATURE_ALARM_MAIN_FAILURE=True
FEATURE_INCWO_SITE_DOWN=True
FEATURE_ALARM_DG_ON=True
FEATURE_INCWO_RESOLVED=True
FEATURE_IT_NODE=True

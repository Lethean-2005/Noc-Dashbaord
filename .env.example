# ============================================================
# Application
# ============================================================
APP_NAME=Dashboard
APP_ENV=development
APP_DEBUG=True
SECRET_KEY=change_this_to_a_long_random_secret_key

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# PostgreSQL Database
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_db
DB_USER=postgres
DB_PASSWORD=your_password
SITE_SYNC_INTERVAL_SECONDS=300
INCIDENT_SYNC_INTERVAL_SECONDS=300
APE_ALARM_SYNC_INTERVAL_SECONDS=900
VIP_ALARM_SYNC_INTERVAL_SECONDS=900
VIP_INCIDENT_ALARM_SYNC_INTERVAL_SECONDS=60
VIP_SITE_SYNC_INTERVAL_SECONDS=300
ALL_TASKS_SUMMARY_INTERVAL_SECONDS=300

# ============================================================
# Database Connection Pool
# ============================================================
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=20

# ============================================================
# MSSQL (alarm source for ISP POP / EZE / TCT cards)
# ============================================================
MSSQL_HOST=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_SYNC_INTERVAL_SECONDS=10

# ============================================================
# Dashboard
# ============================================================
TIMEZONE=Asia/Phnom_Penh
DEFAULT_THEME=light
ROWS_PER_PAGE=25
CARD_LAYOUT_RESET_VERSION=1

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_PATH=logs/app.log
LOG_ERROR_PATH=logs/error.log
ATTEMPTS_LOG_PATH=logs/attempts.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================
# Session
# ============================================================
SESSION_TIMEOUT=3600

# ============================================================
# Notification (Optional)
# ============================================================
TEAMS_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================================
# Security
# ============================================================
CSRF_ENABLED=True

# ============================================================
# Enable and disable features (dashboard card visibility)
# ============================================================
FEATURE_VVIP_SITE=True
FEATURE_MENTOR_SITE=True
FEATURE_ISP_POP=True
FEATURE_TCT_PORT=True
FEATURE_INCIDENT_INCWO_STATUS=True
FEATURE_RAN_STATUS=True
FEATURE_INCIDENT_SITEDOWN=True
FEATURE_ALARM_SITE_DOWN=True
FEATURE_ALARM_COMPLETELY_SITE_DOWN=True
FEATURE_ALARM_MAIN_FAILURE=True
FEATURE_INCWO_SITE_DOWN=True
FEATURE_ALARM_DG_ON=True
FEATURE_INCWO_RESOLVED=True
FEATURE_IT_NODE=True
